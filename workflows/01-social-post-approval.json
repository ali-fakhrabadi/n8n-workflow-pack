    {
      "parameters": {
        "content": "## Publish with retries\nThe post goes out with an **Idempotency-Key** header. 429 and 5xx are retried with exponential backoff and jitter (Retry-After honoured); other 4xx stop at once. A failed run raises an error, so the error workflow alerts and releases the key.",
        "width": 1100,
        "height": 200,
        "color": 7
      },
      "id": "b0b6a7a3-8814-5906-b1c3-858c58afc3e5",
      "name": "Note: publish",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2620,
        -40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.social_api_url }}/v1/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Validate request').first().json.key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $('Validate request').first().json.post.channel, text: $('Validate request').first().json.post.text, media_url: $('Validate request').first().json.post.media_url }) }}"
      },
      "id": "49efc559-757d-5c7c-b6a4-c8c6198d5358",
      "name": "Publish post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "packDownstream01",
          "name": "Downstream API token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Code node \"Classify <step>\" (run once for all items), right after an HTTP Request node that\n// returns the full response and never throws on HTTP errors.\n//\n//   ok       2xx: continue\n//   retry    transient (no response, 408, 429, 5xx) and attempts are left: wait, call again\n//   failed   permanent (other 4xx) or attempts used up: the next node stops the run with an\n//            error, so the error workflow releases the key and raises an alert\n//\n// Backoff: exponential with full jitter, honours Retry-After, capped at 300 s. Attempts and\n// the base wait come from the Settings node, so the harness can shrink them.\nconst STEP = 'publish';\nconst settings = $('Settings').first().json;\nconst maxAttempts = Math.max(1, Number(settings.max_attempts || 4));\nconst baseWaitS = Math.max(0.1, Number(settings.retry_base_s || 5));\n\nconst response = $json || {};\nconst status = Number(response.statusCode || 0);\nconst body = response.body && typeof response.body === 'object' && !Array.isArray(response.body) ? response.body : {};\nconst attempt = $runIndex + 1;\n\nlet route;\nlet transient = false;\nif (status >= 200 && status < 300) {\n  route = 'ok';\n} else if (status === 0 || status === 408 || status === 429 || status >= 500) {\n  transient = true;\n  route = attempt < maxAttempts ? 'retry' : 'failed';\n} else {\n  route = 'failed';\n}\n\nlet waitS = 0;\nif (route === 'retry') {\n  const headers = response.headers || {};\n  const retryAfter = Number(headers['retry-after'] || 0);\n  const ceiling = Math.min(300, baseWaitS * 2 ** (attempt - 1));\n  const jittered = ceiling / 2 + Math.random() * (ceiling / 2);\n  const chosen = Math.min(300, Math.max(jittered, Number.isFinite(retryAfter) ? retryAfter : 0));\n  waitS = Math.round(chosen * 10) / 10;\n}\n\nlet error = null;\nif (route === 'failed') {\n  const why = transient ? `gave up after ${attempt} attempts` : 'permanent error';\n  const detail =\n    (body.error && (body.error.message || body.error.code)) || (response.error && response.error.message) || '';\n  error = `${STEP}: ${why} (HTTP ${status || 'no response'}${detail ? `: ${String(detail).slice(0, 160)}` : ''})`;\n}\n\n// Only a small, bounded copy of the answer is kept as the run's outcome.\nconst outcome = route === 'ok' && JSON.stringify(body).length <= 2000 ? body : route === 'ok' ? { truncated: true } : null;\nreturn [{ json: { step: STEP, route, attempt, status_code: status, wait_s: waitS, error, outcome } }];\n"
      },
      "id": "df37d223-2b22-509c-95ab-18adeebddd45",
      "name": "Classify publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
